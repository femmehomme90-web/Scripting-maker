-- Script for : https://www.roblox.com/fr/games/126884695634066/Grow-a-Garden

local VoidUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/femmehomme90-web/Scripting-maker/refs/heads/main/VoidUi-test"))()
VoidUI:SetScriptName("Grow a Garden script")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ════════════════════════════════════════════════════════
--  DONNÉES
-- ════════════════════════════════════════════════════════

local Plots  = workspace.Map.Plots
local myPlot = nil

for i = 1, 6 do
    local plot = Plots:FindFirstChild("Plot" .. i)
    if plot then
        local att = plot:FindFirstChild("HomeLabelAttachment")
        if att and #att:GetChildren() > 0 then
            myPlot = plot
            break
        end
    end
end

if not myPlot then
    VoidUI:Notify({ Title = "Erreur", Message = "Plot introuvable !", Type = "error", Duration = 4 })
    return
end

local seedRoller = myPlot:FindFirstChild("SeedRoller")
local stands = {}
for i = 1, 6 do
    local stand = seedRoller:FindFirstChild("Stand" .. i)
    if stand then
        stands[i] = { index = i, position = stand:GetPivot().Position }
    end
end

local function getWorldSeeds()
    local seeds = {}
    for _, model in ipairs(workspace:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("BuySeed", true) then
            local seedPos = model:GetPivot().Position
            local bestStand, bestDist = nil, math.huge
            for _, st in pairs(stands) do
                local d = (Vector3.new(seedPos.X, 0, seedPos.Z) - Vector3.new(st.position.X, 0, st.position.Z)).Magnitude
                if d < bestDist then bestDist = d; bestStand = st end
            end
            if bestStand and bestDist < 15 then
                seeds[model.Name] = bestStand.index
            end
        end
    end
    return seeds
end

local function getFarmPlots()
    local out = {}
    for _, name in ipairs({"FarmPlot", "SecondFloor", "ThirdFloor"}) do
        local node = myPlot:FindFirstChild(name)
        if node then
            local fp = name == "FarmPlot" and node or node:FindFirstChild("FarmPlot")
            if fp then table.insert(out, fp) end
        end
    end
    return out
end

-- ── Lecture des graines depuis l'UI du jeu ──
local scrollFrame = game:GetService("Players").LocalPlayer
    .PlayerGui.MainUI.Menus.IndexFrame.Main.ScrollingFrame

local rarityOrder = {
    "Common", "Uncommon", "Rare", "Epic", "Legendary",
    "Divine", "Prismatic", "Secret", "Exotic", "Transcended"
}

local seedsByRarity = {}
for _, r in ipairs(rarityOrder) do seedsByRarity[r] = {} end

for _, child in ipairs(scrollFrame:GetChildren()) do
    if child:IsA("Frame") then
        local icon   = child:FindFirstChild("Icon")
        local rarity = child:FindFirstChild("RarityName")
        local sname  = child:FindFirstChild("SeedName")
        local name   = (sname and sname.Text ~= "???" and sname.Text) or child.Name
        local rar    = (rarity and rarity.Text) or "Common"
        local bucket = seedsByRarity[rar] or seedsByRarity["Common"]
        table.insert(bucket, { Name = name, Icon = icon and icon.Image or "" })
    end
end

-- Construit les groupes pour AddFilteredCardGrid (seulement les raretés non vides)
local seedGroups = {}
for _, r in ipairs(rarityOrder) do
    if #seedsByRarity[r] > 0 then
        table.insert(seedGroups, {
            Label = r,
            Items = seedsByRarity[r],
        })
    end
end

-- ════════════════════════════════════════════════════════
--  UI
-- ════════════════════════════════════════════════════════
local Win = VoidUI:CreateWindow({
    Title       = "Grow a Garden",
    Size        = UDim2.new(0, 650, 0, 500),
    TabPosition = "side",
})

local selectedSeeds = {}
local buying        = false
local stopBuying    = false

-- ════════════════════════════════════════════════════════
--  TAB SEEDS
-- ════════════════════════════════════════════════════════
local TabSeeds = Win:AddTab("Seeds")

local grid = TabSeeds:AddFilteredCardGrid({
    Groups   = seedGroups,
    Columns  = 4,
    Callback = function(sel)
        selectedSeeds = sel
    end,
})

-- Boutons de sélection rapide
TabSeeds:AddButton({
    Label    = "Tout sélectionner (groupe affiché)",
    Callback = function()
        grid:SelectAll()
        VoidUI:Notify({ Title = "Sélection", Message = "Groupe entier sélectionné.", Type = "info", Duration = 2 })
    end,
})

TabSeeds:AddButton({
    Label    = "Tout désélectionner",
    Callback = function()
        grid:DeselectAll()
        VoidUI:Notify({ Title = "Sélection", Message = "Sélection effacée.", Type = "warning", Duration = 2 })
    end,
})

-- ════════════════════════════════════════════════════════
--  TAB AUTO
-- ════════════════════════════════════════════════════════
local TabCtrl = Win:AddTab("Auto")

TabCtrl:AddLabel("Auto-Buy")
TabCtrl:AddToggle({
    Label   = "Activer Auto-Buy",
    Default = false,
    Callback = function(state)
        if state then
            if buying then return end
            buying = true; stopBuying = false
            task.spawn(function()
                while not stopBuying do
                    if next(selectedSeeds) == nil then task.wait(1); continue end
                    ReplicatedStorage.Remotes.RollSeeds:FireServer()
                    task.wait(3)
                    for seedName, standIdx in pairs(getWorldSeeds()) do
                        if stopBuying then break end
                        if selectedSeeds[seedName] then
                            ReplicatedStorage.Remotes.BuySeed:FireServer(standIdx)
                            VoidUI:Notify({ Title = "Acheté !", Message = seedName .. " → Stand" .. standIdx, Type = "success", Duration = 3 })
                            task.wait(0.5)
                        end
                    end
                end
                buying = false
            end)
        else
            stopBuying = true
            VoidUI:Notify({ Title = "Stoppé", Message = "Auto-buy arrêté.", Type = "warning", Duration = 3 })
        end
    end,
})

TabCtrl:AddLabel("Auto-Collect")
local collecting = false
local stopCollecting = false
TabCtrl:AddToggle({
    Label   = "Activer Auto-Collect",
    Default = false,
    Callback = function(state)
        if state then
            if collecting then return end
            collecting = true; stopCollecting = false
            task.spawn(function()
                while not stopCollecting do
                    ReplicatedStorage.Remotes.SellCrates:FireServer()
                    VoidUI:Notify({ Title = "Collect !", Message = "Caisses vendues.", Type = "success", Duration = 2 })
                    task.wait(120)
                end
                collecting = false
            end)
        else
            stopCollecting = true
            VoidUI:Notify({ Title = "Stoppé", Message = "Auto-collect arrêté.", Type = "warning", Duration = 3 })
        end
    end,
})

TabCtrl:AddLabel("Auto-Upgrade Plants")
local targetLevel = 10
TabCtrl:AddSlider({ Label = "Niveau cible", Min = 1, Max = 75, Default = 10, Callback = function(v) targetLevel = v end })
TabCtrl:AddButton({
    Label  = "▶ Upgrade toutes les plantes",
    Colors = { Color3.fromRGB(255, 140, 40), Color3.fromRGB(255, 200, 40) },
    Callback = function()
        local farmPlots = getFarmPlots()
        if #farmPlots == 0 then
            VoidUI:Notify({ Title = "Erreur", Message = "FarmPlot introuvable !", Type = "error", Duration = 3 })
            return
        end
        task.spawn(function()
            local upgraded = 0
            for _, fp in ipairs(farmPlots) do
                for _, plant in ipairs(fp:GetChildren()) do
                    local dirt = plant:FindFirstChild("Dirt")
                    if dirt and dirt:GetAttribute("PlantLevel") ~= nil then
                        local lvl = dirt:GetAttribute("PlantLevel") or 0
                        while lvl < targetLevel do
                            ReplicatedStorage.Remotes.UpgradePlant:InvokeServer(dirt)
                            task.wait(0.1)
                            lvl = dirt:GetAttribute("PlantLevel") or 0
                        end
                        upgraded += 1
                    end
                end
            end
            VoidUI:Notify({ Title = "Upgrade terminé !", Message = upgraded .. " plante(s) au niveau " .. targetLevel, Type = "success", Duration = 4 })
        end)
    end,
})

-- ════════════════════════════════════════════════════════
--  TAB INFO
-- ════════════════════════════════════════════════════════
local TabInfo = Win:AddTab("Info")
TabInfo:AddLabel("Plot détecté")
TabInfo:AddButton({ Label = myPlot.Name, Callback = function() end })
TabInfo:AddLabel("Stands au démarrage")
for name, idx in pairs(getWorldSeeds()) do
    TabInfo:AddLabel(name .. "  →  Stand" .. idx)
end
